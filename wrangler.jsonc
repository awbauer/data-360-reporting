// Cloudflare Workers deployment: the built SPA is served as static assets, and the
// same Hono app that runs on Node handles /api/* and /auth/* in the Worker.
//
// Before the first deploy:
//   npx wrangler secret put SESSION_KEY        # 32+ random chars (openssl rand -hex 32); or add it in
//                                              # the dashboard with type "Secret". Deploys never overwrite it.
//   npx wrangler secret put SF_CLIENT_ID       # or put it in "vars" below; it isn't secret
//   npx wrangler secret put SF_CLIENT_SECRET   # skip this: PKCE without a secret is preferred
// Then: npm run deploy   (or let a Workers Builds git integration run `npx wrangler deploy`;
// the "build" step below produces dist/web first)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "data360-workbench",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // No preview URLs for this Worker.
  "preview_urls": false,

  // Build the SPA before every deploy (also covers Cloudflare's git-connected builds, whose
  // default deploy step is just `wrangler deploy`). Needs devDependencies installed, which is the default.
  "build": { "command": "npm run build" },

  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    // Client-side routes (/explorer/..., /query) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only these hit the Worker; every other path is served straight from assets.
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  // Keep variables set in the Cloudflare dashboard. Without this, `wrangler deploy` deletes any
  // plaintext variable that isn't listed in "vars" below. (Secrets are never touched by a deploy.)
  "keep_vars": true,

  "vars": {
    "NODE_ENV": "production"
    // APP_BASE_URL defaults to the request's origin, so OAuth callbacks follow whatever
    // hostname you attach. Set it only if you front the Worker with a different public URL.
    // "APP_BASE_URL": "https://workbench.example.com",
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Note: false logs full query strings, which on /auth/callback include the OAuth `code` and `state`.
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  }
}
