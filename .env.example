# --- Required in production -------------------------------------------------
# 32+ random characters used to encrypt session cookies (openssl rand -hex 32).
SESSION_KEY=
# Public URL users reach the app at. The OAuth callback is APP_BASE_URL/auth/callback.
APP_BASE_URL=https://workbench.example.com

# --- App sign-in (Better Auth) -----------------------------------------------
# At least one provider is required in production. Callback URLs:
#   GitHub OAuth app: APP_BASE_URL/api/auth/callback/github
#   Google OAuth client: APP_BASE_URL/api/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in (provider-verified emails only). Required in production; empty = nobody.
AUTH_ALLOWED_DOMAINS=publicissapient.com,publicisgroupe.net,publicis.com
AUTH_ALLOWED_EMAILS=
# Who can read the audit log of every query (also allowed in).
AUTH_ADMIN_EMAILS=
# Optional: Better Auth's signing key. Derived from SESSION_KEY when unset.
# BETTER_AUTH_SECRET=
# How long query audit entries are kept.
AUDIT_RETENTION_DAYS=180
# SQLite file for Node deployments (Cloudflare uses the D1 binding instead).
DATABASE_PATH=./data/workbench.db

# --- Salesforce External Client App -----------------------------------------
# Consumer key of the External Client App (PKCE, no secret recommended).
# Optional if users paste their own on the Connect screen.
SF_CLIENT_ID=
# Recommended: leave empty. Sign-in always uses PKCE; set a secret only if your app requires one
# (i.e. "Require secret for Web Server flow" is on and you can't turn it off).
SF_CLIENT_SECRET=
# Default login host for the "Production" option. Use your My Domain if you prefer.
SF_LOGIN_URL=https://login.salesforce.com
SF_SCOPES=api refresh_token cdp_query_api cdp_profile_api
SF_API_VERSION=v65.0
# The server only talks to hosts under these suffixes (SSRF guard).
ALLOWED_SF_HOST_SUFFIXES=.salesforce.com,.force.com

# Ask Salesforce to vet the sign-in request first so a bad key or callback shows a message.
# SF_AUTHORIZE_PREFLIGHT=1

# --- Query behaviour ---------------------------------------------------------
QUERY_WORKLOAD_NAME=data360-workbench
QUERY_TIMEOUT_MS=300000
FIRST_CHUNK_ROWS=1000
MAX_EXPORT_ROWS=100000

# --- Misc --------------------------------------------------------------------
PORT=8787
NODE_ENV=production
# Sample data, no Salesforce needed. Refused when NODE_ENV=production.
# DATA360_MOCK=1

# --- Web build (read by Vite at build time) ---------------------------------
# Repository and branch that hold queries/ for the "Propose" and "Edit on GitHub" links.
# VITE_LIBRARY_REPO=awbauer/data-360-reporting
# VITE_LIBRARY_BRANCH=main
